# TabPFN-3.5 weights are gated: accept the license at https://platform.priorlabs.ai
# and paste your key here. Without it the open TabPFN v2 weights are used.
TABPFN_TOKEN=

# Optional: which local model plays the Medium and the Skeptic
EMPTY_ROOM_MODEL=gemma-4-e4b
# LM Studio by default; Ollama is http://localhost:11434/v1
LLM_BASE_URL=http://localhost:1234/v1

# Optional: the Skeptic's web_search tool
SERPAPI_API_KEY=

# Optional: --narrate
ELEVENLABS_API_KEY=
# The free plan can only use ElevenLabs default voices through the API, not library voices.
ELEVENLABS_MEDIUM_VOICE=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_SKEPTIC_VOICE=JBFqnCBsd6RMkjVDRZzb

# Optional: agent tracing
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
